<div class="container py-5">
  <h2 class="fw-bold text-danger mb-4">
    <i class="bi bi-speedometer2 me-2"></i>管理者ダッシュボード
  </h2>

  <div class="row mb-5">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-primary text-white">
        <div class="card-body p-4">
          <h6 class="text-uppercase small fw-bold opacity-75">総ユーザー数</h6>
          <h2 class="display-6 fw-bold mb-0"><%= @total_users_count %> <small class="fs-6">名</small></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-dark text-white">
        <div class="card-body p-4">
          <h6 class="text-uppercase small fw-bold opacity-75">総投稿数</h6>
          <h2 class="display-6 fw-bold mb-0"><%= @total_posts_count %> <small class="fs-6">件</small></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-danger text-white">
        <div class="card-body p-4">
          <h6 class="text-uppercase small fw-bold opacity-75">本日の新規投稿</h6>
          <h2 class="display-6 fw-bold mb-0"><%= @today_posts_count %> <small class="fs-6">件</small></h2>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">最近の投稿監視</h4>
    <div class="d-flex justify-content-end mb-3">
      <%= link_to admin_users_path, class: "btn btn-outline-dark" do %>
        <i class="bi bi-person-lines-fill me-1"></i> ユーザー管理へ
      <% end %>
    </div>
  </div>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-danger"><i class="bi bi-shield-lock-fill"></i> 管理者用：全投稿一覧</h2>
    <span class="badge bg-secondary">合計: <%= @posts.count %> 件</span>
  </div>

  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th>投稿日</th>
            <th>チーム</th>
            <th>投稿者</th>
            <th>タイトル</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @posts.each do |post| %>
            <tr>
              <td class="small"><%= l post.created_at, format: :short %></td>
              <td><span class="badge bg-outline-primary text-primary border border-primary"><%= post.team.name %></span></td>
              <td><%= post.user.name %></td>
              <td class="fw-bold"><%= link_to post.title, team_post_path(post.team, post), target: "_blank" %></td>
              <td>
                <%= link_to admin_post_path(post), method: :delete, data: { confirm: "この投稿を強制削除しますか？" }, class: "btn btn-outline-danger btn-sm" do %>
                  <i class="bi bi-trash"></i> 削除
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
