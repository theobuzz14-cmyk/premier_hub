<div class="container py-5">
  <h2 class="mb-4">通報一覧</h2>
  <table class="table table-hover shadow-sm bg-white">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>通報対象</th>
        <th>通報者</th>
        <th>理由</th>
        <th>ステータス</th>
        <th>通報日時</th>
        <th>詳細</th>
      </tr>
    </thead>
    <tbody>
      <% @reports.each do |report| %>
        <tr>
          <td><%= report.id %></td>
          <td>
            <% if report.thread_id.present? %>
              <span class="badge bg-primary">スレッド</span>
            <% else %>
              <span class="badge bg-info text-dark">コメント</span>
            <% end %>
          </td>
          <td><%= report.user.name %></td>
          <td class="text-truncate" style="max-width: 200px;"><%= report.reason %></td>
          <td>
            <% if report.pending? %>
              <span class="badge bg-warning text-dark">未処理</span>
            <% else %>
              <span class="badge bg-success">処理済</span>
            <% end %>
          </td>
          <td><%= l report.created_at, format: :short %></td>
          <td><%= link_to "確認", admin_report_path(report), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>