<div class="container py-5">
  <h2 class="fw-bold text-danger mb-4">
    <i class="bi bi-people-fill me-2"></i>ユーザー管理
  </h2>

  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th>ID</th>
            <th>名前</th>
            <th>メールアドレス</th>
            <th>ステータス</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.id %></td>
              <td class="fw-bold"><%= user.name %></td>
              <td><%= user.email %></td>
              <td>
                <% if user.is_active %>
                  <span class="badge bg-success">有効</span>
                <% else %>
                  <span class="badge bg-secondary">退会済み/停止</span>
                <% end %>
              </td>
              <td>
                <% unless user.admin? %> <%# 管理者自身は操作不能にする %>
                  <%= link_to admin_user_path(user), method: :patch, 
                      data: { confirm: "ステータスを変更しますか？" }, 
                      class: "btn btn-sm #{user.is_active ? 'btn-outline-danger' : 'btn-outline-success'}" do %>
                    <%= user.is_active ? "停止する" : "復旧させる" %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>