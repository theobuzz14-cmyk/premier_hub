<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      
      <%# 戻るリンク %>
      <div class="mb-4">
        <%= link_to group_path(@group), class: "text-decoration-none text-muted small" do %>
          <i class="bi bi-arrow-left"></i> グループ詳細に戻る
        <% end %>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-4 border-bottom-0">
          <h1 class="h4 fw-bold mb-1 text-center">参加申請の管理</h1>
          <p class="text-muted small text-center mb-0">「<%= @group.name %>」への申請を確認・処理できます</p>
        </div>

        <div class="card-body p-0">
          <% if @pending_users.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="ps-4 py-3">ユーザー名</th>
                    <th class="text-end pe-4 py-3">アクション</th>
                  </tr>
                </thead>
                <tbody>
                  <% @pending_users.each do |gu| %>
                    <tr>
                      <td class="ps-4">
                        <div class="d-flex align-items-center">
                          <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="bi bi-person-fill"></i>
                          </div>
                          <span class="fw-bold"><%= gu.user.name %></span>
                        </div>
                      </td>
                      <td class="text-end pe-4">
                        <div class="d-flex justify-content-end gap-2">
                          <%# 承認ボタン %>
                          <%= link_to group_user_path(gu), method: :patch, class: "btn btn-success btn-sm rounded-pill px-3" do %>
                            <i class="bi bi-check-lg"></i> 承認
                          <% end %>
                          
                          <%# 却下ボタン %>
                          <%= link_to group_user_path(gu), method: :delete, data: { confirm: "この申請を却下してもよろしいですか？" }, class: "btn btn-outline-danger btn-sm rounded-pill px-3" do %>
                            <i class="bi bi-x-lg"></i> 却下
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <div class="mb-3">
                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
              </div>
              <p class="text-muted">現在、新しい参加申請はありません。</p>
              <%= link_to '詳細に戻る', group_path(@group), class: "btn btn-outline-secondary btn-sm rounded-pill" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-4 p-3 bg-light rounded-3">
        <p class="small text-muted mb-0">
          <i class="bi bi-info-circle me-1"></i> <strong>ヒント:</strong> 承認すると、そのユーザーはグループ内での交流（スレッドへの参加など）が可能になります。
        </p>
      </div>

    </div>
  </div>
</div>