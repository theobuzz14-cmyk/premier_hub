<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-sm border-0">
        <div class="card-body p-5">
          <h1 class="h3 fw-bold mb-4 text-center">新規グループ作成</h1>

          <%= form_with model: @group, local: true do |f| %>
            <%= render 'shared/error_messages', object: f.object %>
            <div class="mb-3">
              <%= f.label :name, "グループ名", class: "form-label fw-bold" %>
              <%= f.text_field :name, class: "form-control", placeholder: "50文字以内で入力してください" %>
            </div>

            <div class="mb-3">
              <%= f.label :introduction, "紹介文", class: "form-label fw-bold" %>
              <%= f.text_area :introduction, class: "form-control", rows: 4, placeholder: "500文字以内で入力してください" %>
            </div>

            <div class="mb-4">
              <%= f.label :team_id, "対象チーム", class: "form-label fw-bold" %>
              <%= f.collection_select :team_id, Team.all, :id, :name, { include_blank: "選択してください" }, { class: "form-select" } %>
            </div>

            <div class="d-grid gap-2">
              <%= f.submit "作成する", class: "btn btn-primary btn-lg rounded-pill" %>
              <%= link_to '戻る', groups_path, class: "btn btn-link text-muted" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>