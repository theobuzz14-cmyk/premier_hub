<header>
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm py-3">
    <div class="container">
      <%= link_to root_path, class: "navbar-brand d-flex align-items-center me-4" do %>
        <%= image_tag 'logo.png', alt: 'Premier Hub Logo', height: '40', class: 'me-2' %>
        <span class="fw-bold" style="color: #002097; font-size: 1.5rem;">Premier Hub</span>
      <% end %>
      
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <%= link_to "About", about_path, class: "nav-link px-3 fw-medium" %>
          </li>
        </ul>
        
        <ul class="navbar-nav ms-auto align-items-center">
          <% if user_signed_in? %>
            <li class="nav-item">
              <%= link_to "マイページ", mypage_users_path, class: "nav-link px-3 fw-medium" %>
            </li>
            <% if current_user.admin? %>
              <li class="nav-item">
                <%= link_to "管理画面", admin_posts_path, class: "nav-link px-3 fw-bold text-danger" %>
              </li>
            <% end %>
            <li class="nav-item ms-lg-3">
              <%= link_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn-outline-primary px-4" %>
            </li>
          <% else %>
            <li class="nav-item">
              <%= link_to "新規登録", new_user_registration_path, class: "nav-link px-3 fw-medium" %>
            </li>
            <li class="nav-item ms-lg-3">
              <%= link_to "ログイン", new_user_session_path, class: "btn btn-primary px-4 text-white" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>

  <% if user_signed_in? %>
    <div class="search-bar-container bg-light py-3 border-bottom shadow-sm">
      <div class="container">
        <%= form_with url: search_path, method: :get, local: true, class: "row g-2 justify-content-center" do |f| %>
          <div class="col-auto">
            <%= f.select :model, [["投稿", "post"], ["ユーザー", "user"]], { selected: params[:model] }, { class: "form-select shadow-sm" } %>
          </div>
          <div class="col-md-6 col-12">
            <div class="input-group">
              <%= f.text_field :query, value: params[:query], class: "form-control shadow-sm", placeholder: "キーワードを入力..." %>
              <button class="btn btn-primary shadow-sm px-4" type="submit">
                <i class="bi bi-search"></i> 検索
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</header>