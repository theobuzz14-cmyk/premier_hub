<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <% if @player_data && @player_data['statistics'].present? %>
      <% team_api_id = @player_data['statistics'][0]['team']['id'] %>
      <% team = Team.find_by(api_team_id: team_api_id) %>
      
      <%= link_to team_path(team), class: "text-decoration-none text-muted" do %>
        <i class="bi bi-arrow-left"></i> <%= team.name %> 掲示板へ戻る
      <% end %>
    <% else %>
      <%= link_to '← チーム一覧に戻る', root_path, class: "text-decoration-none text-muted" %>
    <% end %>
    
    <%# 比較相手選択プルダウン %>
    <% if @team_players.present? %>
      <div class="col-md-4">
        <%= form_with url: player_path(params[:id]), method: :get, local: true, class: "d-flex gap-2" do |f| %>
          <%= f.select :compare_id, 
              options_for_select([['選手を比較する...', '']] + @team_players.map { |p| [p['name'], p['id']] }, params[:compare_id]),
              {}, 
              { class: "form-select form-select-sm shadow-sm", onchange: "this.form.submit();" } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @player_data %>
    <% player = @player_data['player'] %>
    <% stats = @player_data['statistics'][0] %>

    <div class="row g-4">
      <%# 左側：プロフィールカード %>
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm text-center p-4">
          <div class="mb-3">
            <img src="<%= player['photo'] %>" alt="<%= player['name'] %>" class="rounded-circle shadow-sm" style="width: 150px; height: 150px; object-fit: cover;">
          </div>
          <h1 class="h3 fw-bold mb-1"><%= player['name'] %></h1>
          <p class="text-muted mb-3"><%= stats['team']['name'] %> / <%= stats['games']['position'] %></p>
          
          <div class="row g-2 text-start border-top pt-3">
            <div class="col-6 small text-muted">国籍:</div>
            <div class="col-6 small fw-bold"><%= player['nationality'] %></div>
            <div class="col-6 small text-muted">年齢:</div>
            <div class="col-6 small fw-bold"><%= player['age'] %>歳</div>
            <div class="col-6 small text-muted">身長/体重:</div>
            <div class="col-6 small fw-bold"><%= player['height'] %> / <%= player['weight'] %></div>
          </div>
        </div>
      </div>

      <%# 右側：スタッツ表示 %>
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4 h-100">
          <h2 class="h5 fw-bold mb-4">2024-25 シーズンスタッツ</h2>
          
          <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
              <div class="display-6 fw-bold text-primary"><%= stats['games']['appearences'] || 0 %></div>
              <div class="small text-muted">出場試合</div>
            </div>
            <div class="col-md-3 col-6">
              <div class="display-6 fw-bold text-success"><%= stats['goals']['total'] || 0 %></div>
              <div class="small text-muted">ゴール</div>
            </div>
            <div class="col-md-3 col-6">
              <div class="display-6 fw-bold text-info"><%= stats['goals']['assists'] || 0 %></div>
              <div class="small text-muted">アシスト</div>
            </div>
            <div class="col-md-3 col-6">
              <div class="display-6 fw-bold text-warning"><%= stats['games']['rating'] ? stats['games']['rating'].to_f.round(2) : '-' %></div>
              <div class="small text-muted">評価点</div>
            </div>
          </div>

          <hr class="my-4">

          <div class="row mb-4">
            <div class="col-md-6">
              <ul class="list-group list-group-flush small">
                <li class="list-group-item d-flex justify-content-between px-0">パス成功率 <span><%= stats['passes']['accuracy'] %>%</span></li>
                <li class="list-group-item d-flex justify-content-between px-0">シュート数 <span><%= stats['shots']['total'] || 0 %></span></li>
              </ul>
            </div>
            <div class="col-md-6">
              <ul class="list-group list-group-flush small">
                <li class="list-group-item d-flex justify-content-between px-0">タックル <span><%= stats['tackles']['total'] || 0 %></span></li>
                <li class="list-group-item d-flex justify-content-between px-0">ドリブル <span><%= stats['dribbles']['success'] || 0 %></span></li>
              </ul>
            </div>
          </div>

          <%# バタフライチャート（比較時のみ） %>
          <% if @compare_player_data %>
            <% c_player = @compare_player_data['player'] %>
            <% c_stats = @compare_player_data['statistics'][0] %>

            <div class="mt-4 p-4 bg-light rounded shadow-sm border">
              <div class="d-flex justify-content-between align-items-center mb-4 px-lg-5 text-center">
                <div style="width: 80px;">
                  <img src="<%= player['photo'] %>" class="rounded-circle mb-2 border border-primary shadow-sm" style="width: 50px;">
                  <div class="fw-bold" style="font-size: 0.7rem;"><%= player['name'] %></div>
                </div>
                <div class="h5 fw-bold text-muted">VS</div>
                <div style="width: 80px;">
                  <img src="<%= c_player['photo'] %>" class="rounded-circle mb-2 border border-danger shadow-sm" style="width: 50px;">
                  <div class="fw-bold" style="font-size: 0.7rem;"><%= c_player['name'] %></div>
                </div>
              </div>

                <% [
                  ['ゴール', stats.dig('goals', 'total') || 0, c_stats.dig('goals', 'total') || 0],
                  ['アシスト', stats.dig('goals', 'assists') || 0, c_stats.dig('goals', 'assists') || 0],
                  ['パス成功率', stats.dig('passes', 'accuracy') || 0, c_stats.dig('passes', 'accuracy') || 0],
                  ['評価点', (stats.dig('games', 'rating').to_f.round(2) rescue 0), (c_stats.dig('games', 'rating').to_f.round(2) rescue 0)]
                ].each do |label, v1, v2| %>
                <div class="mb-3">
                  <div class="d-flex justify-content-between small mb-1">
                    <span class="<%= comparison_color(v1, v2) %>"><%= v1 %><%= label == 'パス成功率' ? '%' : '' %></span>
                    <span class="text-muted fw-bold"><%= label %></span>
                    <span class="<%= comparison_color(v2, v1) %>"><%= v2 %><%= label == 'パス成功率' ? '%' : '' %></span>
                  </div>
                  <div class="progress" style="height: 10px; background-color: #e9ecef;">
                    <div class="progress-bar bg-primary" style="width: <%= calculate_ratio(v1, v2) %>%"></div>
                    <div class="progress-bar bg-danger" style="width: <%= 100 - calculate_ratio(v1, v2) %>%"></div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="alert alert-warning">選手データを読み込めませんでした。</div>
  <% end %>
</div>