<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="mb-4 text-center">
        <h2 class="fw-bold">スレッドを編集</h2>
        <p class="text-muted"><%= @team.name %> のスレッド内容を修正します</p>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
          <%= form_with(model: [@team, @post], local: true) do |f| %>
            <div class="mb-3">
              <%= f.label :title, "スレッドタイトル", class: "form-label fw-bold" %>
              <%= f.text_field :title, class: "form-control form-control-lg" %>
            </div>

            <div class="mb-4">
              <%= f.label :body, "内容", class: "form-label fw-bold" %>
              <%= f.text_area :body, rows: 6, class: "form-control" %>
            </div>

            <div class="d-grid gap-2">
              <%= f.submit "更新する", class: "btn btn-primary btn-lg rounded-pill shadow-sm" %>
              <%= link_to "キャンセル", team_post_path(@team, @post), class: "btn btn-outline-secondary rounded-pill" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>