<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <h2 class="fw-bold mb-4">
        <% if @query.present? %>
          「<%= @query %>」の検索結果（<%= @posts.count %>件）
        <% else %>
          検索キーワードを入力してください
        <% end %>
      </h2>

      <div class="list-group shadow-sm">
        <% if @posts.any? %>
          <% @posts.each do |post| %>
            <%= link_to team_post_path(post.team, post), class: "list-group-item list-group-item-action p-4 border-0 mb-2 rounded shadow-sm" do %>
              <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-1 fw-bold text-primary"><%= post.title %></h5>
                <span class="badge bg-light text-dark border"><%= post.team.name %></span>
              </div>
              <p class="mb-2 text-muted text-truncate"><%= post.body %></p>
              <div class="d-flex align-items-center text-muted small">
                <span class="me-3"><i class="bi bi-person"></i> <%= post.user.name %></span>
                <span><i class="bi bi-clock"></i> <%= l post.created_at, format: :short %></span>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="text-center py-5 bg-white rounded shadow-sm">
            <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
            <p class="mt-3 text-muted">該当するスレッドが見つかりませんでした。</p>
            <%= link_to "トップに戻る", root_path, class: "btn btn-primary rounded-pill mt-2" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>