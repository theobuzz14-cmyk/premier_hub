<div class="container py-4">
  <h2 class="h4 fw-bold mb-4">
    <%= @model == 'user' ? 'ユーザー' : '投稿' %>検索結果: "<%= @query %>"
  </h2>

  <% if @results.any? %>
    <div class="row g-4">
      <% if @model == 'user' %>
        <%# ユーザーの表示 %>
        <% @results.each do |user| %>
          <div class="col-md-4">
            <div class="card shadow-sm border-0 p-3 text-center h-100">
              <div class="mb-2">
                <%= link_to user.name, user_path(user), class: "fw-bold text-dark text-decoration-none h5" %>
              </div>
              <div class="small text-muted"><%= user.posts.count %> 投稿</div>
            </div>
          </div>
        <% end %>
      <% else %>
        <%# 投稿の表示 %>
        <% @results.each do |post| %>
          <div class="col-12">
            <div class="card shadow-sm border-0 mb-3 hover-shadow transition">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <%# タイトルを表示し、詳細ページへのリンクにする %>
                  <h5 class="card-title mb-0">
                    <%= link_to post.title, [post.team, post], class: "text-decoration-none text-primary fw-bold" %>
                  </h5>
                  <span class="small text-muted"><%= l post.created_at, format: :short %></span>
                </div>
                
                <div class="small text-muted mb-2">投稿者: <%= post.user.name %></div>
                
                <%# 本文を表示（検索ワードをハイライト） %>
                <p class="card-text text-secondary">
                  <%= highlight(truncate(post.body, length: 150), @query) %>
                </p>
                
                <div class="text-end">
                  <%= link_to '詳細を見る →', [post.team, post], class: "btn btn-sm btn-outline-primary" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-warning border-0 shadow-sm">一致する結果が見つかりませんでした。</div>
  <% end %>
</div>