<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
  <% @teams.each do |team| %>
    <div class="col">
      <div class="card h-100 shadow-sm border-0">
        <div class="card-body text-center">
          <div class="mb-3 d-flex align-items-center justify-content-center" style="height: 80px;">
            <% if team.logo_url.present? %>
              <%= image_tag team.logo_url, alt: team.name, class: "img-fluid h-100", style: "object-fit: contain;" %>
            <% else %>
              <%# ロゴがない場合のテキスト表示 %>
              <div class="rounded-circle bg-light d-flex align-items-center justify-content-center border" style="width: 60px; height: 60px;">
                <span class="fw-bold text-secondary" style="font-size: 1.5rem;"><%= team.name.first %></span>
              </div>
            <% end %>
          </div>
          
          <h5 class="card-title fw-bold"><%= team.name %></h5>
          <%= link_to 'スレッドを見る', team_path(team), class: 'btn btn-outline-primary btn-sm mt-2 stretched-link' %>
        </div>
      </div>
    </div>
  <% end %>
</div>