<div class="container py-5">
  <div class="text-center mb-5">
    <% if @team.logo_url.present? %>
      <%= image_tag @team.logo_url, alt: @team.name, style: "height: 100px; object-fit: contain;", class: "mb-3" %>
    <% end %>
    <h1 class="display-5 fw-bold"><%= @team.name %> 掲示板</h1>
    <%= link_to "← チーム一覧に戻る", root_path, class: "text-decoration-none text-muted" %>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4 mb-0">スレッド一覧</h2>
        <%= link_to new_team_post_path(@team), class: "btn btn-primary rounded-pill px-4 shadow-sm" do %>
          <i class="bi bi-plus-lg"></i> 新規スレッドを作成
        <% end %>
      </div>

      <% if @posts.any? %>
        <div class="list-group shadow-sm">
          <% @posts.each do |post| %>
            <%= link_to team_post_path(@team, post), class: "list-group-item list-group-item-action p-4 border-start-0 border-end-0 border-top-0" do %>
              <div class="d-flex w-100 justify-content-between align-items-center">
                <h5 class="mb-1 fw-bold text-dark"><%= post.title %></h5>
                <small class="text-muted">投稿者: <%= post.user.name %></small>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="card shadow-sm p-5 text-center bg-light border-0">
          <p class="text-muted mb-0">まだスレッドはありません。最初のスレッドを立ててみませんか？</p>
        </div>
      <% end %>
    </div>

    <div class="col-md-8 mt-5">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-4 text-center">
          <h5 class="fw-bold mb-3">
            <i class="bi bi-people-fill me-2"></i>コミュニティ機能
          </h5>
          <p class="text-muted small mb-4">このチームのファン同士で交流できるグループを作成・閲覧できます。</p>
          <div class="d-grid gap-2 d-md-block">
            <%= link_to 'グループ一覧を見る', groups_path(team_id: @team.id), class: "btn btn-info rounded-pill px-4 me-md-2" %>
            <%= link_to '新しいグループを作る', new_group_path(team_id: @team.id), class: "btn btn-outline-primary rounded-pill px-4" %>
          </div>
        </div>
      </div>
    </div>
    
  </div>
</div>