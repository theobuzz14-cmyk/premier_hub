<div class="container py-5">
  <div class="row">
    <div class="col-md-4">
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body text-center p-4">
          <div class="mb-3">
            <%# アイコン画像がある場合は表示、ない場合はデフォルトアイコン %>
            <% if @user.avatar.attached? %>
              <%= image_tag @user.avatar, class: "rounded-circle border shadow-sm", style: "width: 120px; height: 120px; object-fit: cover;" %>
            <% else %>
              <i class="bi bi-person-circle text-secondary" style="font-size: 5rem;"></i>
            <% end %>
          </div>
          <h3 class="fw-bold mb-1"><%= @user.name %></h3>
          <p class="text-muted small">Premier Hub サポーター</p>

          <%# 管理者が他人のページを見た時だけ、管理用の退会処理ボタンを出す %>
          <% if user_signed_in? && current_user.admin? && @user != current_user %>
            <hr>
            <div class="d-grid mt-3">
              <p class="text-danger small fw-bold mb-2">管理者用メニュー</p>
              <%= link_to admin_user_path(@user), 
                          method: :patch, 
                          data: { confirm: "このユーザーを退会状態にしますか？" }, 
                          class: "btn btn-outline-danger btn-sm rounded-pill" do %>
                <i class="bi bi-person-x"></i> ユーザーを停止する
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-8">
      <h4 class="fw-bold mb-4">
        <i class="bi bi-chat-left-text me-2"></i><%= @user.name %> さんの投稿一覧
      </h4>

      <% if @posts.any? %>
        <div class="list-group shadow-sm border-0">
          <% @posts.each do |post| %>
            <%= link_to team_post_path(post.team, post), class: "list-group-item list-group-item-action p-4 border-0 mb-2 rounded shadow-sm" do %>
              <div class="d-flex justify-content-between align-items-center">
                <p class="text-muted small mb-0">
                  <i class="bi bi-clock"></i> <%= l post.created_at, format: :long %>
                </p>
                <span class="text-primary small">
                  続きを読む <i class="bi bi-chevron-right"></i>
                </span>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-5 bg-white rounded shadow-sm border border-dashed">
          <i class="bi bi-chat-dots text-muted" style="font-size: 3rem;"></i>
          <p class="text-muted mt-3 mb-0">まだ投稿はありません。</p>
        </div>
      <% end %>

      <div class="text-center mt-5">
        <%= link_to :back, class: "btn btn-link text-muted text-decoration-none" do %>
          <i class="bi bi-arrow-left"></i> 前の画面に戻る
        <% end %>
      </div>
    </div>
  </div>
</div>